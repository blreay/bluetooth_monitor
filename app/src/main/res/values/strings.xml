<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">蓝牙手环重启·后台</string>

    <!-- ===================== Toasts ===================== -->

    <!-- Shown unconditionally the moment the band is seen. Short duration,
         no confirmation needed, disappears by itself. -->
    <string name="toast_band_found">已找到手环，正在重启蓝牙…</string>

    <!-- Shown unconditionally once the chain observes STATE_ON again. -->
    <string name="toast_restored">蓝牙已恢复</string>

    <!-- Debug only, enabled by the toast extra (Notifier.EXTRA_TOAST). %1$s is
         the Result or Action enum name, which is why this is a format string. -->
    <string name="toast_outcome">蓝牙重启: %1$s</string>

    <!-- Always shown, regardless of the debug flag: if the grant is missing
         nothing works and the user has no other way to find out why. -->
    <string name="toast_permission_denied">未授予「附近的设备」权限，无法扫描或开关蓝牙</string>

    <!-- ===================== Notification channel ===================== -->

    <string name="notif_channel_name">运行结果</string>
    <string name="notif_channel_desc">每次运行后报告扫描结果与蓝牙重启的结局</string>

    <!-- ===================== Titles, one per outcome ===================== -->

    <string name="notif_title_found">已找到手环，正在重启蓝牙</string>
    <string name="notif_title_not_found">未找到手环</string>
    <string name="notif_title_bluetooth_off">蓝牙未开启</string>
    <string name="notif_title_no_adapter">本机没有蓝牙适配器</string>
    <string name="notif_title_permission">缺少「附近的设备」权限</string>
    <string name="notif_title_disable_refused">未能安排安全恢复</string>
    <string name="notif_title_scan_error">扫描出错</string>
    <string name="notif_title_restored">蓝牙已恢复</string>
    <string name="notif_title_gave_up">蓝牙重启失败</string>

    <!-- ===================== Shared scan facts line =====================

         Appended to nearly every body so the notification carries the numbers
         that discriminate one failure from another.
         %1$.1f seconds actually scanned, %2$.1f seconds requested,
         %3$d distinct devices seen, %4$d of those carrying an advertised name -->
    <string name="notif_facts">扫描 %1$.1f/%2$.1f 秒 · 看到 %3$d 个设备（%4$d 个带广播名）</string>

    <!-- ===================== One hint per NotFoundReason ===================== -->

    <!-- %1$d is the onScanFailed code -->
    <string name="notif_hint_scan_failed">系统报告扫描失败，errorCode=%1$d。错误码 2 表示扫描客户端注册失败；不能据此断言是扫描次数限流</string>

    <!-- %1$d count, %2$s a short sample of what was seen -->
    <string name="notif_hint_near_miss">看到 %1$d 个疑似手环但没匹配上：%2$s。手环可能换了广播名，改 BandMatcher.kt 顶部的常量</string>

    <string name="notif_hint_cut_short">本次扫描窗口未完整结束，不能确认目标是否在广播；请检查系统限制与省电设置</string>

    <string name="notif_hint_nothing">未收到任何设备广播。可能是次数限流、系统限制或周围没有可见广播，不能仅凭零结果确定原因；等 30 秒后再运行一次</string>

    <string name="notif_hint_no_band">收到了其他设备广播，但本次没有收到匹配目标手环的广播</string>

    <!-- Appended to notif_hint_no_band. A bonded band that is connected has
         stopped advertising, which is the single most common reason a user
         swears the device is visible while the scan correctly sees nothing. -->
    <string name="notif_note_bonded">。在已读取的配对列表诊断中匹配到目标；配对缓存不是广播命中，也不能证明当前连接或广播状态</string>
    <string name="notif_note_not_bonded">。本次配对列表诊断未匹配到目标（也可能未能读取）；配对缓存不是当前命中依据</string>

    <!-- ===================== Bodies for the non-scan outcomes ===================== -->

    <!-- %1$s is the matched name or address -->
    <string name="notif_body_found">已命中当前广播 %1$s。安全恢复记录与闹钟已安排，尚未确认蓝牙关闭；先尝试 Shizuku，不可用时自动尝试普通方式</string>

    <!-- %1$s is the AdapterState -->
    <string name="notif_body_bluetooth_off">当前蓝牙状态 %1$s，按设计直接退出，没有做任何操作</string>

    <string name="notif_body_no_adapter">取不到 BluetoothAdapter，这台设备可能没有蓝牙硬件</string>

    <string name="notif_body_permission">需要「附近的设备」SCAN/CONNECT 权限才能扫描和开关蓝牙。首次打开会申请；拒绝后不重复弹窗，点击通知详情可显式重试</string>

    <string name="notif_body_disable_refused">找到了当前目标广播，但安全持久化或恢复闹钟安排失败，未派发关闭蓝牙；请查看详情与系统状态</string>

    <string name="notif_body_scan_error">扫描过程中出错，详情看 adb logcat 的 BtReset.Ctrl</string>

    <!-- ===================== Bodies for the slow phase ===================== -->

    <!-- %1$d ticks; one tick is one second, so ticks are seconds -->
    <string name="notif_body_restored">已观察到蓝牙 ON，共 %1$d 次观察；闹钟可能延迟，次数不等于保证秒数</string>

    <string name="notif_body_gave_up_no_adapter">重开途中取不到蓝牙适配器，已放弃</string>

    <!-- %1$d ticks -->
    <string name="notif_body_gave_up_never_off">%1$d 跳内蓝牙一直没关成，已放弃。蓝牙还开着，没有坏。通常是 MIUI 弹框没点允许</string>

    <!-- %1$d ticks -->
    <string name="notif_body_gave_up_never_on">%1$d 跳内蓝牙没能重新开起来，已放弃，需要手动开一次</string>
</resources>
