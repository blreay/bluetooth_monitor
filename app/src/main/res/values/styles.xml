<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Small dialog-style entry point: does NOT overlay touch, finishes in < 2 s.
         All scanning / toggling happens inside the foreground service. -->
    <style name="Theme.BluetoothMonitor" parent="android:style/Theme.Material.Light.Dialog.MinWidth">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:colorAccent">#008BBD</item>
    </style>
    <color name="launcher_background">#072B43</color>
</resources>