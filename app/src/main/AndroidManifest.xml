<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- minSdk 31: Nearby devices, not location. Manual toggles do not request these. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Legacy recovery uses exact alarms, with an inexact fallback when unavailable. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Legacy broadcast outcomes use notifications; target32 leaves the prompt to the system. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.BtReset">

        <!-- MAIN and RUN open a normal visible task; neither starts a Bluetooth operation. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.blreay.bluetoothmonitor.action.RUN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Protection for binder delivery, not a permission granted to this application. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Retained legacy service; the manual UI never starts it. -->
        <service
            android:name=".ResetService"
            android:exported="false" />

        <!-- Existing automation protocol: an explicit target-detect-and-reset request. -->
        <receiver
            android:name=".TriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.blreay.bluetoothmonitor.action.RESET_IF_PRESENT" />
            </intent-filter>
        </receiver>

        <!-- Manifest declaration lets the durable legacy alarm restart a reclaimed app process. -->
        <receiver
            android:name=".ReEnableReceiver"
            android:exported="false" />

    </application>
</manifest>
